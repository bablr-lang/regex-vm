{
  "name": "@bablr/regex-vm",
  "version": "0.0.0",
  "description": "A fully streaming regular expression engine",
  "engines": {
    "node": ">=12.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/**/*.js"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "mocha test/*.test.js",
    "verify": "npm run lint && npm run test && codecov",
    "format": "prettier --write '**/*.{js,md}'",
    "lint": "eslint ."
  },
  "lint-staged": {
    "*.js": [
      "eslint"
    ],
    "*.md": [
      "prettier -c"
    ]
  },
  "dependencies": {
    "@bablr/agast-helpers": "0.10.10",
    "@bablr/agast-vm-helpers": "0.10.5",
    "@bablr/pattern-engine": "0.2.0",
    "@bablr/stream-iterator": "2.0.0",
    "@iter-tools/imm-stack": "1.2.0",
    "functional-red-black-tree": "1.0.1"
  },
  "devDependencies": {
    "@bablr/boot": "0.11.4",
    "@bablr/eslint-config-base": "github:bablr-lang/eslint-config-base#23b94fb3bdfdbc3ac7ed9cb58d7979d8f07dce2b",
    "enhanced-resolve": "^5.12.0",
    "eslint": "^7.32.0",
    "eslint-import-resolver-enhanced-resolve": "^1.0.5",
    "eslint-plugin-import": "^2.27.5",
    "expect": "^29.6.2",
    "lint-staged": "^10.2.11",
    "mocha": "^10.2.0",
    "prettier": "^2.0.5"
  },
  "keywords": [
    "regex",
    "regexp",
    "regular",
    "iterator",
    "iterable",
    "match",
    "test",
    "engine",
    "capture",
    "stream",
    "streaming",
    "non-backtracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bablr-lang/regex-vm.git"
  },
  "homepage": "https://github.com/bablr-lang/regex-vm",
  "author": "Conrad Buck <conartist6@gmail.com>",
  "license": "MIT"
}
